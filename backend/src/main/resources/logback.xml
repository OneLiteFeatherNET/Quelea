<configuration>
    <property name="LOG_JSON" value="${LOG_JSON:-false}"/>

    <if condition='"true".equalsIgnoreCase(property("LOG_JSON"))'>
        <then>
            <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
                <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                    <fieldNames>
                        <timestamp>timestamp</timestamp>
                        <message>message</message>
                        <logger>logger</logger>
                        <thread>thread</thread>
                        <level>level</level>
                    </fieldNames>
                </encoder>
            </appender>
        </then>
        <else>
            <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
                <encoder>
                    <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n</pattern>
                </encoder>
            </appender>
        </else>
    </if>

    <!-- ERROR events go to Sentry, INFO and above become breadcrumbs. Attached under OTEL, not beside it: the OTel
         appender hands its children an event whose MDC carries trace_id, while a sibling on root gets the original
         event without it. The DSN is not set here: the Sentry bean (observability.SentryLifecycle) initialises the SDK
         only when QUELEA_SENTRY_DSN is set, so without a DSN nothing is sent. -->
    <appender name="SENTRY" class="io.sentry.logback.SentryAppender">
        <minimumEventLevel>ERROR</minimumEventLevel>
        <minimumBreadcrumbLevel>INFO</minimumBreadcrumbLevel>
    </appender>

    <appender name="OTEL" class="io.opentelemetry.instrumentation.logback.mdc.v1_0.OpenTelemetryAppender">
        <appender-ref ref="STDOUT"/>
        <appender-ref ref="SENTRY"/>
    </appender>

    <!-- Request bodies carry party chat messages and player names; the HTTP server and the netty handlers
         would print them at DEBUG/TRACE, so they are pinned to INFO/WARN here whatever else is raised. -->
    <logger name="io.micronaut.http.server" level="INFO"/>
    <logger name="io.micronaut.http.client" level="INFO"/>
    <logger name="io.netty" level="WARN"/>
    <logger name="reactor.netty" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="OTEL"/>
    </root>
</configuration>
